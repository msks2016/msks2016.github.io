# Only needed if you want to preview the site on your own computer.
# GitHub Pages ignores this file and builds the site itself.
#
#   bundle install
#   bundle exec jekyll serve      → open http://localhost:4000
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"                     # needed by `jekyll serve` on Ruby 3+
